# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit actual secrets.

# Postgres connection string. Locally, `docker compose up -d db` gives you:
#   postgresql://family_planner:family_planner@localhost:5432/family_planner?schema=public
# In production (Vercel), use a *pooled* connection string — e.g. Neon's
# "-pooler" host, provisioned via Vercel's Storage tab — so concurrent
# serverless invocations don't exhaust direct Postgres connections.
DATABASE_URL=""

# The domain households get a subdomain under, e.g. "planner.example.com" —
# a household at subdomain "smiths" is then reachable at
# smiths.planner.example.com. Leave UNSET for local dev and for any Vercel
# deployment before you've pointed a real domain at the project; every
# request then falls back to DEV_SUBDOMAIN below instead of routing by host.
ROOT_DOMAIN=""

# Only used when ROOT_DOMAIN is unset: which household's subdomain to treat
# every local request as. Matches the seed script's default household.
DEV_SUBDOMAIN="demo"

# Signs the session cookie issued after a successful unlock (see lib/auth.ts
# and proxy.ts). Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=""
