# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit actual secrets.

# SQLite connection string. Prisma resolves relative paths against the
# directory the process is run from (the project root for `next dev`/`next
# start`), not against prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Shared household password gating the whole app (see proxy.ts and
# app/[locale]/unlock/page.tsx). Pick a real passphrase for production.
SITE_PASSWORD=""

# Signs the session cookie issued after a successful unlock. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=""
